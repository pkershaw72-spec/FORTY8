#!/bin/bash
# Downloads Sorter: moves loose files in ~/Downloads into category subfolders.
# Written for the bash 3.2 that ships with macOS.
#
#   --plan   print what would be sorted: line 1 the file count, line 2
#            "undo" or "no-undo", then one line per category
#   --yes    sort, print the summary
#   --undo   put the files from the last sort back
#
# The Downloads Sorter app runs this script and shows the dialogs.
#
# DOWNLOADS_SORTER_DIR overrides the folder to sort (default: ~/Downloads).

set -u

DIR="${DOWNLOADS_SORTER_DIR:-$HOME/Downloads}"
STATE_DIR="${DOWNLOADS_SORTER_STATE:-$HOME/Library/Application Support/DownloadsSorter}"
LAST_RUN="$STATE_DIR/last-run.tsv"
TAB=$'\t'

case "${1:-}" in
  --plan|--yes|--undo) MODE="${1#--}" ;;
  *) echo "usage: downloads-sorter --plan | --yes | --undo" >&2; exit 2 ;;
esac

category_for() {
  local name="$1" ext
  case "$name" in
    *.*) ext=$(printf '%s' "${name##*.}" | tr '[:upper:]' '[:lower:]') ;;
    *) echo "Other"; return ;;
  esac
  case "$ext" in
    jpg|jpeg|png|gif|heic|heif|webp|tiff|tif|bmp|svg|raw|cr2|nef|dng|psd|ai|ico|icns) echo "Images" ;;
    mp4|mov|m4v|avi|mkv|wmv|webm|flv|mpg|mpeg) echo "Videos" ;;
    mp3|m4a|wav|aac|flac|aiff|aif|ogg|wma|m4b) echo "Audio" ;;
    pdf) echo "PDFs" ;;
    doc|docx|dot|dotx|pages|rtf|txt|md|odt|tex|msg|eml) echo "Documents" ;;
    xls|xlsx|xlsm|xlsb|xltx|csv|tsv|numbers|ods) echo "Spreadsheets" ;;
    ppt|pptx|pptm|potx|key|odp) echo "Presentations" ;;
    zip|tar|gz|tgz|bz2|xz|7z|rar|zst) echo "Archives" ;;
    dmg|pkg|mpkg|iso|exe|msi) echo "Installers" ;;
    epub|mobi|azw|azw3) echo "eBooks" ;;
    ttf|otf|woff|woff2) echo "Fonts" ;;
    ics|vcf) echo "Calendar and Contacts" ;;
    py|ipynb|r|rmd|sql|js|ts|html|htm|css|json|xml|yaml|yml|sh|swift|java|c|cpp|h|go|rs|rb|php|parquet|sqlite|db) echo "Code and Data" ;;
    *) echo "Other" ;;
  esac
}

# Files a browser is still writing.
in_progress() {
  case "$1" in
    *.crdownload|*.download|*.part|*.partial|*.opdownload) return 0 ;;
  esac
  return 1
}

# A path that does not exist yet: "name.ext", then "name (1).ext", ...
unique_path() {
  local folder="$1" name="$2" base ext n=1 candidate
  candidate="$folder/$name"
  case "$name" in
    *.*) base="${name%.*}"; ext=".${name##*.}" ;;
    *) base="$name"; ext="" ;;
  esac
  while [ -e "$candidate" ] || [ -L "$candidate" ]; do
    candidate="$folder/$base ($n)$ext"
    n=$((n + 1))
  done
  printf '%s' "$candidate"
}

say() { printf '%s\n' "$1"; }
fail() { printf '%s\n' "$1" >&2; exit 1; }

undo_last() {
  if [ ! -s "$LAST_RUN" ]; then say "There is no previous sort to undo."; return; fi
  local restored=0 skipped=0 dest src
  while IFS="$TAB" read -r dest src; do
    if [ -f "$dest" ] && [ ! -e "$src" ] && mv -n "$dest" "$src" 2>/dev/null; then
      restored=$((restored + 1))
      rmdir "${dest%/*}" 2>/dev/null      # drop the category folder once it is empty
    else
      skipped=$((skipped + 1))
    fi
  done < "$LAST_RUN"
  rm -f "$LAST_RUN"
  local msg="Put $restored file(s) back in Downloads."
  [ "$skipped" -gt 0 ] && msg="$msg $skipped could not be restored (moved, renamed or replaced since)."
  say "$msg"
}

[ -d "$DIR" ] || fail "Cannot find the folder $DIR."
ls "$DIR" >/dev/null 2>&1 || fail "Downloads Sorter is not allowed to read $DIR. Switch on Downloads Folder for it under System Settings > Privacy & Security > Files and Folders, then try again."
mkdir -p "$STATE_DIR"

if [ "$MODE" = "undo" ]; then undo_last; exit 0; fi

# Build the plan: one "Category<TAB>filename" line per loose file.
PLAN=$(mktemp "${TMPDIR:-/tmp}/downloads-sorter.XXXXXX")
trap 'rm -f "$PLAN"' EXIT
for path in "$DIR"/*; do
  name="${path##*/}"
  [ -f "$path" ] && [ ! -L "$path" ] || continue      # leave folders, apps and links alone
  in_progress "$name" && continue
  case "$name" in *"$TAB"*|*$'\n'*) continue ;; esac
  printf '%s\t%s\n' "$(category_for "$name")" "$name" >> "$PLAN"
done

TOTAL=$(wc -l < "$PLAN" | tr -d ' ')
SUMMARY=$(cut -f1 "$PLAN" | sort | uniq -c | sort -rn | sed -E 's/^ *([0-9]+) (.*)$/  \2: \1/')

if [ "$MODE" = "plan" ]; then
  echo "$TOTAL"
  if [ -s "$LAST_RUN" ]; then echo "undo"; else echo "no-undo"; fi
  [ -n "$SUMMARY" ] && printf '%s\n' "$SUMMARY"
  exit 0
fi
if [ "$TOTAL" -eq 0 ]; then echo "Nothing to sort."; exit 0; fi

# Move the files, recording each move so it can be undone.
: > "$LAST_RUN"
moved=0; failed=0
while IFS="$TAB" read -r category name; do
  src="$DIR/$name"
  [ -f "$src" ] || continue
  if mkdir -p "$DIR/$category" && dest=$(unique_path "$DIR/$category" "$name") && mv -n "$src" "$dest" 2>/dev/null && [ ! -e "$src" ]; then
    printf '%s\t%s\n' "$dest" "$src" >> "$LAST_RUN"
    moved=$((moved + 1))
  else
    failed=$((failed + 1))
  fi
done < "$PLAN"

result="Sorted $moved file(s)."
[ "$failed" -gt 0 ] && result="$result $failed could not be moved and were left in place."

printf '%s\n\n%s\n' "$result" "$SUMMARY"
